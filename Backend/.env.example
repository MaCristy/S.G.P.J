# Configurações Gerais da Aplicação
APP_NAME="Sistema de Gestão da Prática Jurídica (S.G.P.J.)"
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Conexão com o Banco de Dados MySQL (SGPJ)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Poppy@26
DB_NAME=sgpj

# Pool de Conexões SQLAlchemy
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=True

# Segurança e Autenticação (JWT)
SECRET_KEY= dfe1dbe538fb061ad874579159f16e6bbf51251c185d90ec3227344dc1d3cb85
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Parâmetros de Negócio (RN05 - Janela flexível de alerta de prazos)
PRAZO_ALERTA_DIAS=5

# CORS - Origens autorizadas para o Frontend
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

